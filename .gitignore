# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.pytest_cache/

# Logs
*.log

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Generated runtime data (developer's local files — never check in)
voice-archive/
*.tmp

# Cold-tier audio
.cold/

# Recordings never enter the repo. The archive + voice.db live under
# data_root; this block is defense in depth so a recording dropped ANYWHERE
# inside the repo can't be committed. _samples/ holds per-voice preview clips.
*.mp3
*.wav
*.pcm
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.aif
*.aiff
voice.db
voice.db-*
_samples/

# Swift / macOS app build artifacts
.build/
*.app
DerivedData/
*.metallib

# Local config overrides (your own settings never get committed;
# backends.local.json is covered by *.local.*)
.env
.env.local
*.local.toml
*.local.*
data/

# Local-only model-bypass mock fixtures (pre-existing chunk WAVs replayed when
# a render carries mock=true). Local only, never shipped.
mock-fixtures/
