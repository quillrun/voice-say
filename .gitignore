# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.pytest_cache/

# Logs
*.log

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Generated runtime data (developer's local files — never check in)
voice-archive/
voice-history.jsonl
voice-progress.jsonl
voice-overlays.jsonl
*.tmp

# Cold-tier audio
.cold/

# Recordings never enter the repo. The archive + voice.db live under
# data_root; this block is defense in depth so a recording dropped ANYWHERE
# inside the repo can't be committed. _samples/ holds per-voice preview clips.
*.mp3
*.wav
*.pcm
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.aif
*.aiff
voice.db
voice.db-*
_samples/

# Swift / macOS app build artifacts
.build/
*.app
DerivedData/
*.metallib

# Local config overrides (personal settings never get committed)
.env
.env.local
*.local.toml
*.local.*
data/

# Private backend overlays — e.g. a cloned-voice catalog injected via
# VOICE_SAY_BACKENDS_CONFIG. Keeps a personal voice (its ids + host) out of the
# public repo. `backends.local.json` is already covered by `*.local.*`.
*.private.json

# Local-only model-bypass mock fixtures (pre-existing chunk WAVs replayed when
# a render carries mock=true). Generated on the dev box, never shipped.
mock-fixtures/
